{
  "name": "opencode-auto-retitle",
  "version": "0.1.0",
  "description": "OpenCode plugin that keeps session titles current as long sessions change topic",
  "license": "MIT",
  "author": "Anton Ödman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banjo/opencode-auto-retitle.git"
  },
  "homepage": "https://github.com/banjo/opencode-auto-retitle#readme",
  "keywords": ["opencode", "opencode-plugin"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
